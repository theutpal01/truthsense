# Docker Environment Configuration for TruthSense Backend
# Copy this file to .env and configure your values

# Server Configuration
NODE_ENV=production
PORT=8002

# Database (SQLite path for Docker volume)
DB_PATH=/app/data/database.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long-and-random
JWT_EXPIRES_IN=24h

# Email Configuration (SMTP) - REQUIRED
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Redis Configuration (Docker service name)
REDIS_URL=redis://redis:6379

# Rate Limiting Configuration
OTP_RATE_LIMIT_WINDOW=15
OTP_RATE_LIMIT_MAX=5

# File Upload Configuration
MAX_FILE_SIZE=50MB
ALLOWED_AUDIO_TYPES=audio/wav,audio/webm,audio/mp3,audio/m4a

# AI Processing Configuration
AI_PROCESSING_TIMEOUT=300000

# IMPORTANT NOTES:
# 1. Change JWT_SECRET to a long random string in production
# 2. Configure EMAIL_USER and EMAIL_PASSWORD with your SMTP credentials
# 3. For Gmail, use an "App Password" instead of your regular password
# 4. All other settings have sensible defaults for Docker deployment